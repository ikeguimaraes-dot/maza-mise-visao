# Supabase do grupo Maza — mesmo projeto do financeiro (dncqjezvndoxeqpklefy).
# Os dados do MISE vivem no schema `mise`, não em `public`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — leitura server-side do schema `mise` (bypassa RLS).
# NUNCA expor no bundle do client.
SUPABASE_SERVICE_ROLE_KEY=

# URL do shell (maza-maza) — usado pelo middleware para redirecionar
# usuários sem sessão para o login central, e pelo Sidebar para buscar
# a config de navegação em /api/nav.
NEXT_PUBLIC_SHELL_URL=https://maza-maza.vercel.app
